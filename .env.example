# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (ChatGPT) - Optional, for fallback or direct use
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key - Optional, for fallback or direct use
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API Key & Search Engine ID (Optional)
# 1. Get Search API Key at: https://developers.google.com/custom-search/v1/overview
# 2. Create Search Engine ID (cx) at: https://programmablesearchengine.google.com/
# Note: Real-time Google News search works instantly even without these keys!
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
